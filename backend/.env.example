PORT=5001
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Tuỳ chọn. Đặt khi URI KHÔNG ghi tên database — nếu không mongoose sẽ
# lặng lẽ dùng `test`. Bỏ trống thì tên trong URI được giữ nguyên.
MONGODB_DB_NAME=
CLIENT_URL=http://localhost:5173

ACCESS_TOKEN_SECRET=<random-hex-string>
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
